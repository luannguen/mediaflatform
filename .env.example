# Supabase Auth + API (public key is safe for the browser; service-role key is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key

# PostgreSQL connection for migration and integration scripts; never expose as NEXT_PUBLIC_*
DIRECT_URL=postgresql://postgres:replace-password@db.your-project.supabase.co:5432/postgres
# DATABASE_URL may be used instead. Hosted database connections verify TLS.
# PGSSL_ROOT_CERT=/absolute/path/to/database-ca.crt
# PGSSL_DISABLE=true # Local database only

STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=media-assets
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate independent random secrets. Changing an existing API key salt invalidates its hashes.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
API_KEY_SECRET_SALT=replace-before-issuing-api-keys
DELIVERY_GRANT_SECRET=replace-with-an-independent-random-secret
WORKER_SERVICE_TOKEN=sec_worker_replace-with-a-random-worker-only-secret
# Optional signing-key rotation: DELIVERY_GRANT_KEYS={"current_kid":"v1","keys":{"v1":"secret"}}
# WORKER_POLL_INTERVAL_MS=3000
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe

# Demo broker remains disabled unless explicitly configured for an isolated demo tenant.
DEMO_ENABLED=false
# DEMO_WORKSPACE_ID=
# DEMO_USER_ID=
