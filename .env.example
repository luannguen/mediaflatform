# ==============================================================================
# MEDIA PLATFORM ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Supabase Configuration (Get from your Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 2. Storage Configuration
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=media-assets

# 3. Security & Hashing
API_KEY_SECRET_SALT=media_platform_secret_salt_change_this_in_production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Environment & Admin Credentials
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password-here

# 5. Worker Daemon Service Account
WORKER_SERVICE_TOKEN=sec_worker_example_token_replace_me_in_production

# 6. Automated Testing Credentials
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=your-secure-admin-password-here
